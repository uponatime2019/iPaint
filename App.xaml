<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="iPaint.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iPaint">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <!-- WinUI 3 / Fluent styles -->

            <Style x:Key="RoundEditorButton" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="23" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#DDDDDD" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#1B1B1B" />
            </Style>

            <Style x:Key="BottomBarButton" TargetType="Button">
                <Setter Property="Width" Value="96" />
                <Setter Property="Height" Value="62" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#1B1B1B" />
            </Style>

            <Style x:Key="MiniRoundButton" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="15" />
                <Setter Property="Background" Value="#EDEDED" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#1B1B1B" />
            </Style>

            <Style x:Key="ToolRailButton" TargetType="Button">
                <Setter Property="Width" Value="62" />
                <Setter Property="Height" Value="62" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Margin" Value="4,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#1B1B1B" />
            </Style>

            <Style x:Key="SettingsTabButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Foreground" Value="#1B1B1B" />
                <Setter Property="MinHeight" Value="44" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
