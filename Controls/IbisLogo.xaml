<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="iPaint.Controls.IbisLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
        <TextBlock x:Name="LeftText"
                   Text="ibis"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="0,0,2,0" />
        <Canvas x:Name="WheelCanvas" VerticalAlignment="Center" />
        <TextBlock x:Name="RightText"
                   Text="aint"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="2,0,0,0" />
    </StackPanel>
</UserControl>
