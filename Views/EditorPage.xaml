<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="iPaint.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="#E6E6E6">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <!-- ============ Canvas host (full width; tool rail floats on top) ============ -->
        <Grid x:Name="CanvasHost" Grid.Row="0">
                <ScrollViewer x:Name="CanvasScroller"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Enabled"
                              VerticalScrollMode="Enabled"
                              ZoomMode="Enabled"
                              Background="#C0C0C0">
                    <Grid x:Name="CanvasHolder" Width="2048" Height="2048">
                        <Grid x:Name="CanvasGrid">
                            <Border x:Name="CanvasBorder"
                                    BorderBrush="#9A9A9A"
                                    BorderThickness="0,0,1,1" />
                            <Image x:Name="CanvasImage" PointerPressed="OnCanvasPointerPressed"
                                   PointerMoved="OnCanvasPointerMoved"
                                   PointerReleased="OnCanvasPointerReleased"
                                   PointerCaptureLost="OnCanvasPointerReleased"
                                   PointerWheelChanged="OnCanvasWheel" />
                            <!-- Grid overlay in canvas coordinates (scales with the canvas) -->
                            <Canvas x:Name="GridOverlay" IsHitTestVisible="False" />
                            <!-- transform frame -->
                            <Border x:Name="TransformFrame"
                                    BorderBrush="#2196F3" BorderThickness="1"
                                    Visibility="Collapsed" IsHitTestVisible="False" />
                            <!-- selection outline -->
                            <Rectangle x:Name="SelectionOutline"
                                       Stroke="#2196F3" StrokeThickness="1" StrokeDashArray="4 3"
                                       Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- Reference window -->
                <Border x:Name="ReferenceWindow"
                        Width="180" Height="180"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="10,0,0,80"
                        BorderBrush="#666" BorderThickness="1"
                        Background="#FFF"
                        Visibility="Collapsed">
                    <Image x:Name="ReferenceImage" Stretch="Uniform" />
                </Border>

                <!-- Top-right circular buttons -->
                <StackPanel Orientation="Horizontal" Spacing="14"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,32,14,0">
                    <Button x:Name="CanvasSettingsButton" Style="{StaticResource RoundEditorButton}" Click="OnCanvasSettingsClick">
                        <FontIcon Glyph="&#xE8B9;" FontSize="20" />
                    </Button>
                    <Button x:Name="SelectionButton" Style="{StaticResource RoundEditorButton}" Click="OnSelectionClick">
                        <FontIcon Glyph="&#xE906;" FontSize="20" />
                    </Button>
                    <Button x:Name="StabilizerButton" Style="{StaticResource RoundEditorButton}" Click="OnStabilizerClick">
                        <FontIcon Glyph="&#xE7C2;" FontSize="20" />
                    </Button>
                    <Button x:Name="RulerButton" Style="{StaticResource RoundEditorButton}" Click="OnRulerClick">
                        <FontIcon Glyph="&#xE9CE;" FontSize="20" />
                    </Button>
                    <Button x:Name="MaterialsButton" Style="{StaticResource RoundEditorButton}" Click="OnMaterialsClick">
                        <FontIcon Glyph="&#xE8EC;" FontSize="20" />
                    </Button>
                </StackPanel>

                <!-- ============ Floating tool panel (replaces fixed left rail) ============ -->
                <Border x:Name="ToolFloatPanel"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10,10,0,0"
                        CornerRadius="12"
                        Background="#EAFBFBFB"
                        BorderBrush="#BBBBBB" BorderThickness="1">
                    <StackPanel>
                        <!-- header; chevron collapses to a pill -->
                        <Grid x:Name="ToolFloatHeader" Height="34" Background="Transparent">
                            <Button x:Name="ToolFloatCollapse" Style="{StaticResource MiniRoundButton}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="0"
                                    Click="OnToolFloatCollapseClick" ToolTipService.ToolTip="Collapse tools">
                                <FontIcon Glyph="&#xE70D;" FontSize="11" />
                            </Button>
                        </Grid>
                        <ScrollViewer MaxHeight="560"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel x:Name="ToolRail" VerticalAlignment="Top" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- collapsed pill shown while the panel is folded away -->
                <Button x:Name="ToolFloatPill"
                        Style="{StaticResource RoundEditorButton}"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="10,10,0,0"
                        Click="OnToolFloatPillClick" ToolTipService.ToolTip="Show tools">
                    <FontIcon Glyph="&#xE700;" FontSize="18" />
                </Button>

                <!-- Size / zoom row -->
                <Grid VerticalAlignment="Bottom" Margin="130,0,40,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SizeLabel" Text="3.0px" FontSize="14" Foreground="#1A1A1A"
                               VerticalAlignment="Center" Margin="0,0,6,0" MinWidth="52" />
                    <Button x:Name="SizeMinus" Style="{StaticResource RoundEditorButton}" Click="OnSizeMinus" Grid.Column="1" HorizontalAlignment="Left">
                        <FontIcon Glyph="&#xE949;" FontSize="14" />
                    </Button>
                    <Slider x:Name="SizeSlider" Grid.Column="1"
                            Margin="44,0,44,0" VerticalAlignment="Center"
                            ValueChanged="OnSizeSliderChanged" />
                    <Button x:Name="SizePlus" Style="{StaticResource RoundEditorButton}" Grid.Column="1" HorizontalAlignment="Right" Click="OnSizePlus">
                        <FontIcon Glyph="&#xE948;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="ZoomLabel" Text="100%" FontSize="14" Foreground="#1A1A1A"
                               VerticalAlignment="Center" Margin="16,0,6,0" Grid.Column="3" MinWidth="52" />
                    <Slider x:Name="ZoomSlider" Grid.Column="4"
                            Margin="44,0,44,0" VerticalAlignment="Center"
                            ValueChanged="OnZoomSliderChanged" />
                </Grid>
            </Grid>

        <!-- ============ Bottom bar ============ -->
        <Grid Grid.Row="1" Background="#F3F3F3">
                <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center">
                    <Button x:Name="SwapButton" Style="{StaticResource BottomBarButton}" Click="OnSwapClick" ToolTipService.ToolTip="Swap Colors">
                        <FontIcon Glyph="&#xE8B3;" FontSize="22" Foreground="#1B1B1B" />
                    </Button>
                    <Button x:Name="SizePreviewButton" Style="{StaticResource BottomBarButton}" Click="OnSizePreviewClick" ToolTipService.ToolTip="Brush Size">
                        <Grid>
                            <Ellipse x:Name="SizePreviewCircle" Width="38" Height="38" Stroke="#888888" StrokeThickness="2" />
                            <TextBlock x:Name="SizePreviewText" Text="3.0" Foreground="#707070" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,-6" />
                        </Grid>
                    </Button>
                    <Button x:Name="ColorButton" Style="{StaticResource BottomBarButton}" Click="OnColorClick" ToolTipService.ToolTip="Color">
                        <Grid Width="38" Height="38">
                            <Rectangle x:Name="PrevColorRect" Fill="#FFFFFF" HorizontalAlignment="Left" Width="19" />
                            <Rectangle x:Name="CurrentColorRect" Fill="#000000" HorizontalAlignment="Right" Width="19" />
                        </Grid>
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource BottomBarButton}" Click="OnExportClick" ToolTipService.ToolTip="Export / Save">
                        <FontIcon Glyph="&#xE74A;" FontSize="22" Foreground="#1B1B1B" />
                    </Button>
                    <Button x:Name="UndoButton" Style="{StaticResource BottomBarButton}" Click="OnUndoClick" ToolTipService.ToolTip="Undo">
                        <FontIcon Glyph="&#xE7A7;" FontSize="22" Foreground="#1B1B1B" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource BottomBarButton}" Click="OnRedoClick" ToolTipService.ToolTip="Redo">
                        <FontIcon Glyph="&#xE7A6;" FontSize="22" Foreground="#8A8A8A" />
                    </Button>
                    <Button x:Name="LayersButton" Style="{StaticResource BottomBarButton}" Click="OnLayersClick" ToolTipService.ToolTip="Layer">
                        <Grid>
                            <FontIcon Glyph="&#xE81E;" FontSize="22" Foreground="#1B1B1B" />
                            <TextBlock x:Name="LayerCountText" Text="1" Foreground="#1A1A1A" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,-4" />
                        </Grid>
                    </Button>
                    <Button x:Name="BackButton" Style="{StaticResource BottomBarButton}" Click="OnBackClick" ToolTipService.ToolTip="Back">
                        <FontIcon Glyph="&#xE72B;" FontSize="22" Foreground="#1B1B1B" />
                    </Button>
                </StackPanel>
        </Grid>

        <!-- ============ Popups ============ -->
        <!-- Brush / tool panel -->
        <Popup x:Name="ToolPanelPopup" IsLightDismissEnabled="True">
            <Border x:Name="ToolPanelHost" Background="#FBFBFB" CornerRadius="8"
                    BorderBrush="#DDDDDD" BorderThickness="1" />
        </Popup>

        <!-- Layer panel -->
        <Popup x:Name="LayerPopup" IsLightDismissEnabled="True">
            <Border x:Name="LayerPanelHost" Width="700" Height="430" Background="#F6F6F6" CornerRadius="8"
                    BorderBrush="#DDDDDD" BorderThickness="1" />
        </Popup>

        <!-- Color window -->
        <Popup x:Name="ColorPopup" IsLightDismissEnabled="True">
            <Border x:Name="ColorPanelHost" Width="356" Background="#F6F6F6" CornerRadius="8"
                    BorderBrush="#DDDDDD" BorderThickness="1" />
        </Popup>

        <!-- Generic top flyout (canvas settings / selection / stabilizer / ruler / materials) -->
        <Popup x:Name="TopFlyoutPopup" IsLightDismissEnabled="True">
            <Border x:Name="TopFlyoutHost" MinWidth="300" Background="#FBFBFB" CornerRadius="8"
                    BorderBrush="#DDDDDD" BorderThickness="1" />
        </Popup>
    </Grid>
</Page>
