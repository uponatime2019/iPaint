<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="iPaint.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40,24,40,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="iPaint - Draw Anything"
                           FontSize="26"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="for Windows"
                           FontSize="15"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,4" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="SettingsButton"
                    VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}"
                    Padding="10"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Create New -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,24,0,8">
            <Button x:Name="CreateNewButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Height="44"
                    MinWidth="160"
                    FontSize="16"
                    Click="OnCreateNewClick">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE948;" FontSize="16" />
                    <TextBlock Text="Create New" />
                </StackPanel>
            </Button>
            <Button x:Name="ImportButton"
                    Height="44"
                    FontSize="16"
                    Click="OnImportClick">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    <TextBlock Text="Import Picture" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Samples -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Samples"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,8,0,12" />
            <GridView x:Name="SamplesGrid"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnSampleItemClick"
                      Padding="0,4,0,12" />
        </StackPanel>

        <!-- History -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="History"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,8,0,12" />
            <StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                <FontIcon Glyph="&#xF0E2;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="No artworks yet"
                           FontSize="17"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Create a new artwork to get started."
                           FontSize="14"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <GridView x:Name="HistoryGrid"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnHistoryItemClick"
                          Padding="0,4,0,12" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
